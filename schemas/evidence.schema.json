{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/Full-Stack-Notes/schemas/evidence.schema.json",
  "title": "Delivery Pulse Evidence Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptId",
    "requirementIds",
    "repository",
    "baseCommit",
    "headCommit",
    "lane",
    "subject",
    "startedAt",
    "finishedAt",
    "result",
    "evidenceCeiling",
    "cleanup"
  ],
  "properties": {
    "receiptId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{5,127}$"
    },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^FS-[A-Z]+-[0-9]{3}$"
      }
    },
    "repository": {
      "const": "ed3c/Full-Stack-Notes"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "headCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "lane": {
      "type": "string",
      "enum": [
        "contract",
        "unit",
        "integration",
        "browser",
        "security",
        "license",
        "performance",
        "load",
        "chaos",
        "deployment",
        "incident",
        "ai-assisted",
        "enablement"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identity"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["command", "artifact", "image", "deployment", "workflow-run", "game-day", "review"]
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "environment": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "imageDigests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 16,
            "maxLength": 512
          }
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "ABSENT",
        "NOT_IMPLEMENTED",
        "NOT_EXERCISED",
        "SKIPPED_BY_POLICY",
        "BLOCKED_BY_PREDECESSOR",
        "STALE_SUBJECT",
        "PARTIAL",
        "CONTRACT_CLOSED",
        "LIVE_CLOSED"
      ]
    },
    "evidenceCeiling": {
      "type": "string",
      "enum": [
        "documentation",
        "contract",
        "deterministic",
        "integration",
        "runtime",
        "production-like",
        "professional-disclosure"
      ]
    },
    "denominator": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "hardware": {"type": ["string", "null"]},
        "runtime": {"type": ["string", "null"]},
        "dataset": {"type": ["string", "null"]},
        "warmup": {"type": ["string", "null"]},
        "duration": {"type": ["string", "null"]},
        "concurrency": {"type": ["integer", "null"], "minimum": 0},
        "requestMix": {"type": ["string", "null"]},
        "attempts": {"type": ["integer", "null"], "minimum": 0},
        "successes": {"type": ["integer", "null"], "minimum": 0},
        "failures": {"type": ["integer", "null"], "minimum": 0},
        "excluded": {"type": ["integer", "null"], "minimum": 0},
        "percentileMethod": {"type": ["string", "null"]}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "summary", "state"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "state": {
            "type": "string",
            "enum": ["OPEN", "FIXED", "ACCEPTED_RISK", "ISSUE_OWNED"]
          },
          "owner": {
            "type": ["string", "null"],
            "maxLength": 512
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "residue"],
      "properties": {
        "result": {
          "type": "string",
          "enum": ["PASS", "FAIL", "NOT_APPLICABLE", "NOT_EXERCISED"]
        },
        "residue": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "sourceLinks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048
      }
    },
    "humanAdmit": {
      "type": "string",
      "enum": ["REQUIRED", "ADMITTED", "REJECTED", "NOT_APPLICABLE"]
    },
    "notes": {
      "type": ["string", "null"],
      "maxLength": 10000
    }
  }
}
