{
  "name": "@ed3c/full-stack-notes-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite",
    "contract:generate": "node scripts/generate-contract.mjs",
    "contract:check": "npm run contract:generate && git diff --exit-code -- src/contract-generated.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "npm run check && vite build",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --import ./dist-test/test/setup.js --test ./dist-test/test/*.test.js",
    "verify": "npm run contract:check && npm run check && npm test && vite build"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
